# --- Resend (outbound contact form notifications) ---
# Get from https://resend.com/api-keys after creating an account and verifying rameyplumb.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are sent
CONTACT_TO_EMAIL=dkr1997@gmail.com

# The "from" address Resend uses. Must be on a verified Resend domain.
# Use noreply@rameyplumb.com once the domain is verified in Resend.
CONTACT_FROM_EMAIL=noreply@rameyplumb.com

# --- Cloudflare Turnstile (contact form spam protection) ---
# Get from https://dash.cloudflare.com/?to=/:account/turnstile after adding the site
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
