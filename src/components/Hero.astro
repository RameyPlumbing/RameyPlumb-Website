---
import { Image } from "astro:assets";
import CallButton from "./CallButton.astro";
import heroMain from "../assets/gallery/residential/gray-vanity-bathroom.jpg";
import heroAccent from "../assets/gallery/residential/slab-rough-in-truck.jpg";
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-eyebrow">Serving Northeast Mississippi</div>
      <h1>
        From new builds to septic systems &mdash;
        <span class="accent">quality plumbing, done right.</span>
      </h1>
      <p class="hero-sub">
        Residential plumbing, septic systems, and excavation work for Fulton,
        Tupelo, Amory, Oxford, Starkville, and the surrounding communities of
        Northeast Mississippi.
      </p>
      <div class="hero-ctas">
        <a href="#contact" class="btn-primary">Get a Free Estimate</a>
        <CallButton variant="secondary" />
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item"><span class="dot"></span>Fully Insured</div>
        <div class="hero-trust-item"><span class="dot"></span>Weekend Service Available</div>
        <div class="hero-trust-item"><span class="dot"></span>Locally Owned</div>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-img-main">
        <Image
          src={heroMain}
          alt=""
          widths={[400, 600, 800, 1000]}
          sizes="(max-width: 880px) 100vw, 50vw"
          format="webp"
          quality={82}
          loading="eager"
        />
      </div>
      <div class="hero-img-accent">
        <Image
          src={heroAccent}
          alt=""
          widths={[200, 300, 400]}
          sizes="220px"
          format="webp"
          quality={82}
          loading="eager"
        />
      </div>
      <div class="hero-badge">
        <div class="hero-badge-label">Now Serving</div>
        <div class="hero-badge-val">Northeast Mississippi</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-navy-deepest) 0%, var(--color-navy) 50%, var(--color-navy-light) 100%);
    color: white;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -50%; right: -20%;
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(139, 109, 214, 0.18) 0%, transparent 60%);
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 60px;
    align-items: center;
    padding: 90px 48px 80px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }
  .hero-text { position: relative; z-index: 2; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-purple-soft);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .hero-eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--color-purple-soft);
  }
  .hero h1 {
    font-size: 58px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
  }
  .hero h1 .accent {
    color: var(--color-purple-soft);
    display: block;
  }
  .hero-sub {
    font-size: 18px;
    color: var(--color-slate-300);
    max-width: 500px;
    line-height: 1.65;
    margin: 0 0 36px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .hero-trust {
    display: flex;
    gap: 32px;
    padding-top: 28px;
    border-top: 1px solid rgba(255,255,255,0.1);
    flex-wrap: wrap;
  }
  .hero-trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-slate-300);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-trust-item .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-purple-soft);
    box-shadow: 0 0 12px var(--color-purple-soft);
  }

  .hero-visual {
    position: relative;
    height: 520px;
    z-index: 2;
  }
  .hero-img-main {
    position: absolute;
    top: 0; right: 0;
    width: 90%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.45);
  }
  .hero-img-main :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-img-accent {
    position: absolute;
    bottom: -30px; left: -20px;
    width: 220px;
    height: 220px;
    border-radius: 12px;
    overflow: hidden;
    border: 6px solid var(--color-navy-deepest);
    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
  }
  .hero-img-accent :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-badge {
    position: absolute;
    top: 30px; left: -30px;
    background: var(--color-cream);
    color: var(--color-navy-deepest);
    padding: 14px 22px;
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    z-index: 3;
  }
  .hero-badge-label {
    font-size: 10px;
    color: var(--color-slate-700);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 4px;
    font-weight: 600;
  }
  .hero-badge-val {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-navy);
    letter-spacing: -0.01em;
  }

  /* Tablet */
  @media (max-width: 1100px) {
    .hero h1 { font-size: 48px; }
    .hero-inner { gap: 40px; padding: 72px 32px 64px; }
    .hero-visual { height: 440px; }
  }

  /* Mobile */
  @media (max-width: 880px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 56px;
      padding: 56px 24px 64px;
    }
    .hero h1 { font-size: 40px; line-height: 1.08; }
    .hero-sub { font-size: 16px; }
    .hero-trust { gap: 20px; }
    .hero-trust-item { font-size: 11px; }
    .hero-visual { height: 360px; }
    .hero-img-accent { width: 160px; height: 160px; left: 0; bottom: -20px; }
    .hero-badge { left: 0; top: 16px; padding: 10px 16px; }
    .hero-badge-val { font-size: 15px; }
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .hero-ctas :global(a) { width: 100%; }
  }
</style>
