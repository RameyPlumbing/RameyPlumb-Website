---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Eagerly load gallery images so they get processed by Astro's image pipeline.
const residentialMap = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/residential/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
const septicMap = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/septic/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

const residential = Object.values(residentialMap).map(m => m.default);
const septic = Object.values(septicMap).map(m => m.default);

// Interleave residential + septic so the preview shows variety
const preview = [
  residential[0],
  septic[0],
  residential[1],
  septic[1],
  residential[2],
  septic[2],
].filter(Boolean).slice(0, 6) as ImageMetadata[];
---

<section id="gallery-preview" class="gallery-preview">
  <div class="gallery-preview-inner">
    <div class="gallery-preview-header">
      <div>
        <div class="section-label">— Our Work —</div>
        <h2>A look at recent <span class="accent">jobs.</span></h2>
      </div>
      <a href="/gallery" class="gallery-preview-cta">View full gallery →</a>
    </div>

    <div class="gallery-preview-grid">
      {preview.map((img) => (
        <div class="gallery-preview-tile">
          <Image
            src={img}
            alt="Ramey's Plumbing — recent job"
            widths={[300, 500, 700]}
            sizes="(max-width: 880px) 50vw, 33vw"
            format="webp"
            quality={80}
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-preview {
    padding: 100px 48px;
    background: var(--color-cream);
  }
  .gallery-preview-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .gallery-preview-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 40px;
    gap: 24px;
    flex-wrap: wrap;
  }
  .gallery-preview-header h2 {
    font-size: 44px;
    font-weight: 800;
    color: var(--color-navy-deepest);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 12px 0 0;
  }
  .gallery-preview-header h2 .accent { color: var(--color-purple-deep); }
  .gallery-preview-cta {
    color: var(--color-purple-deep);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .gallery-preview-cta:hover {
    border-bottom-color: var(--color-purple-deep);
  }

  .gallery-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gallery-preview-tile {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: white;
  }
  .gallery-preview-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery-preview-tile:hover :global(img) {
    transform: scale(1.05);
  }

  @media (max-width: 880px) {
    .gallery-preview { padding: 64px 24px; }
    .gallery-preview-header h2 { font-size: 30px; }
    .gallery-preview-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  }
</style>
