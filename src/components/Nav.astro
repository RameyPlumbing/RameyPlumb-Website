---
const links = [
  { href: "/", label: "Home" },
  { href: "/#services", label: "Services" },
  { href: "/gallery", label: "Gallery" },
  { href: "/#about", label: "About" },
];
---

<div class="nav-wrap">
  <nav class="nav" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="Ramey's Plumbing — Home">
      <img src="/logo.png" alt="" width="72" height="72" />
      <div class="nav-logo-text">
        Ramey's Plumbing
        <span>Fulton, Mississippi</span>
      </div>
    </a>

    <button
      class="nav-toggle"
      aria-label="Open menu"
      aria-controls="nav-menu"
      aria-expanded="false"
      id="nav-toggle"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="nav-links" id="nav-menu">
      {links.map(link => <a href={link.href}>{link.label}</a>)}
      <a href="/#contact" class="nav-cta">Contact</a>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  function closeMenu() {
    menu?.classList.remove("nav-links-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open menu");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("nav-links-open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });

  // Close menu when a link is tapped on mobile
  menu?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeMenu));

  // Close on escape
  document.addEventListener("keydown", e => {
    if (e.key === "Escape") closeMenu();
  });
</script>

<style>
  .nav-wrap {
    background: white;
    border-bottom: 1px solid var(--color-slate-100);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav {
    max-width: 1400px;
    margin: 0 auto;
    padding: 14px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .nav-logo img {
  width: 72px;
  height: 72px;
  /* Subtle outer ring helps the cream badge separate from the white nav */
  border-radius: 50%;
  box-shadow: 0 0 0 1px rgba(10, 22, 40, 0.06), 0 2px 8px rgba(10, 22, 40, 0.04);
  }
  .nav-logo-text {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.02em;
    color: var(--color-navy-deepest);
    text-transform: uppercase;
    line-height: 1.2;
  }
  .nav-logo-text span {
    display: block;
    color: var(--color-slate-500);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    margin-top: 3px;
    text-transform: uppercase;
  }
  .nav-links {
    display: flex;
    gap: 36px;
    align-items: center;
  }
  .nav-links a {
    color: var(--color-slate-700);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--color-purple-deep); }
  .nav-cta {
    background: var(--color-purple);
    color: white !important;
    padding: 12px 24px;
    border-radius: 9999px;
    font-weight: 700 !important;
    font-size: 13px !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(139, 109, 214, 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(139, 109, 214, 0.4);
    color: white !important;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-navy-deepest);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile */
    @media (max-width: 880px) {
  .nav { padding: 10px 20px; }
  .nav-logo img { width: 48px; height: 48px; }
  .nav-logo-text { font-size: 14px; }
  .nav-logo-text span { font-size: 9px; }

  .nav-toggle {
    display: flex;
  }
  .nav-links {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 8px 20px 16px;
    border-bottom: 1px solid var(--color-slate-100);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease-out;
  }
  .nav-links-open {
    max-height: 400px;
  }
  .nav-links a {
    padding: 12px 4px;
    border-bottom: 1px solid var(--color-slate-100);
    font-size: 15px;
  }
  .nav-cta {
    margin-top: 10px;
    padding: 11px 24px !important;
    text-align: center;
    font-size: 13px !important;
  }
  .nav-links a:last-of-type {
     border-bottom: none;
   }
}
</style>
