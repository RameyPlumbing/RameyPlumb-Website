---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const residentialMap = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/residential/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
const septicMap = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/septic/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

type GalleryItem = { src: ImageMetadata; category: "residential" | "septic" };

const items: GalleryItem[] = [
  ...Object.values(residentialMap).map(m => ({ src: m.default, category: "residential" as const })),
  ...Object.values(septicMap).map(m => ({ src: m.default, category: "septic" as const })),
];
---

<Base
  title="Project Gallery — Ramey's Plumbing Services"
  description="Photos of recent residential plumbing and septic system projects by Ramey's Plumbing Services in Fulton, Mississippi and surrounding Northeast Mississippi communities."
>
  <section class="gallery-hero">
    <div class="gallery-hero-inner">
      <div class="section-label" style="color: var(--color-purple-soft);">— Project Gallery —</div>
      <h1>A look at our <span class="accent">recent work.</span></h1>
      <p>
        Residential plumbing, septic systems, and excavation jobs from across
        Northeast Mississippi.
      </p>
    </div>
  </section>

  <section class="gallery-page">
    <div class="gallery-controls" role="tablist" aria-label="Filter gallery">
      <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">All Work</button>
      <button class="filter-btn" data-filter="residential" role="tab" aria-selected="false">Residential</button>
      <button class="filter-btn" data-filter="septic" role="tab" aria-selected="false">Septic Systems</button>
    </div>

    <div class="gallery-grid" id="gallery-grid">
      {items.map((item, i) => (
        <figure class="gallery-item" data-category={item.category}>
          <Image
            src={item.src}
            alt={`Ramey's Plumbing — ${item.category === "residential" ? "Residential" : "Septic"} project`}
            widths={[400, 600, 800, 1000]}
            sizes="(max-width: 880px) 100vw, (max-width: 1240px) 50vw, 33vw"
            format="webp"
            quality={82}
            loading={i < 6 ? "eager" : "lazy"}
          />
        </figure>
      ))}
    </div>

    <p class="gallery-empty" id="gallery-empty" hidden>
      No photos in this category yet.
    </p>
  </section>
</Base>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item");
  const emptyMsg = document.getElementById("gallery-empty");

  filterBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter || "all";
      filterBtns.forEach(b => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-selected", b === btn ? "true" : "false");
      });

      let visibleCount = 0;
      items.forEach(item => {
        const cat = item.dataset.category;
        const show = filter === "all" || cat === filter;
        item.style.display = show ? "" : "none";
        if (show) visibleCount++;
      });
      if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
    });
  });
</script>

<style>
  .gallery-hero {
    background: linear-gradient(135deg, var(--color-navy-deepest) 0%, var(--color-navy) 100%);
    color: white;
    padding: 80px 48px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .gallery-hero::before {
    content: "";
    position: absolute;
    top: -40%; right: -20%;
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(139, 109, 214, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .gallery-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }
  .gallery-hero h1 {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 16px 0 20px;
  }
  .gallery-hero h1 .accent { color: var(--color-purple-soft); }
  .gallery-hero p {
    font-size: 17px;
    color: var(--color-slate-300);
    line-height: 1.6;
    max-width: 540px;
    margin: 0 auto;
  }

  .gallery-page {
    padding: 60px 48px 100px;
    background: var(--color-bg);
  }

  .gallery-controls {
    max-width: 1240px;
    margin: 0 auto 36px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .filter-btn {
    background: transparent;
    color: var(--color-slate-700);
    border: 1.5px solid var(--color-slate-100);
    padding: 10px 22px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .filter-btn:hover {
    color: var(--color-purple-deep);
    border-color: var(--color-purple-soft);
  }
  .filter-btn.is-active {
    background: var(--color-navy-deepest);
    color: white;
    border-color: var(--color-navy-deepest);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 1240px;
    margin: 0 auto;
  }
  .gallery-item {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-slate-100);
    cursor: zoom-in;
  }
  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .gallery-item:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery-empty {
    text-align: center;
    color: var(--color-slate-500);
    font-size: 15px;
    margin-top: 60px;
  }

  @media (max-width: 1100px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 880px) {
    .gallery-hero { padding: 60px 24px 72px; }
    .gallery-hero h1 { font-size: 38px; }
    .gallery-page { padding: 48px 24px 72px; }
    .gallery-grid { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
